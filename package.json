    "pre-push": "tsc",
    "postbuild": "next-sitemap",
    "markuplint": "markuplint \"./**/*.tsx\"",
    "debug": "NODE_OPTIONS='--inspect' next",
    "prettier": "prettier --write .",
    "test": "vitest",
    "test-cov": "vitest run --coverage",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-sb": "vitest --project=storybook --run",
    "test-sb:cov": "vitest --project=storybook --run --coverage",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@next/third-parties": "16.1.1",
    "@sentry/nextjs": "^10.32.1",
    "@shikijs/rehype": "^3.2.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/og": "^0.8.6",
    "@vercel/speed-insights": "^1.1.0",
    "date-fns": "^4.1.0",
    "microcms-js-sdk": "^3.1.2",
    "next": "16.1.1",
    "next-mdx-remote-client": "^2.1.7",
    "next-themes": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-tweet": "^3.2.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@chromatic-com/storybook": "^4.1.3",
    "@markuplint/jsx-parser": "^4.7.22",
    "@markuplint/react-spec": "^4.5.22",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/nextjs-vite": "^10.1.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "chromatic": "^13.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markuplint": "^4.14.0",
    "next-sitemap": "^4.2.3",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.10",
    "prettier": "^3.7.4",
    "storybook": "^10.1.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "volta": {
    "node": "24.12.0",
    "pnpm": "10.26.2"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@swc/core",
      "@vercel/speed-insights",
      "es5-ext",
      "esbuild",
      "msw",
      "sharp"
    ]
