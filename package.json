{
  "name": "next-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "pre-commit": "lint-staged",
    "pre-push": "tsc",
    "postbuild": "next-sitemap",
    "markuplint": "markuplint \"./**/*.tsx\"",
    "debug": "NODE_OPTIONS='--inspect' next",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest",
    "test-cov": "vitest run --coverage",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-sb": "vitest --project=storybook --run",
    "test-sb:cov": "vitest --project=storybook --run --coverage",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@next/third-parties": "16.1.1",
    "@sentry/nextjs": "^10.32.1",
    "@shikijs/rehype": "^3.2.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/og": "^0.8.6",
    "@vercel/speed-insights": "^1.1.0",
    "date-fns": "^4.1.0",
    "microcms-js-sdk": "^3.1.2",
    "next": "16.2.11",
    "next-mdx-remote-client": "^2.1.7",
    "next-themes": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-tweet": "^3.2.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "chromatic": "^18.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markuplint": "^4.18.3",
    "next-sitemap": "^4.2.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.18",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.19.0"
}
